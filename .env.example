# PostgreSQL connection used by the FastAPI service
DATABASE_URL=postgresql+psycopg://terrashift:terrashift@localhost:5432/terrashift
POSTGRES_USER=terrashift
POSTGRES_PASSWORD=change-me
POSTGRES_DB=terrashift

# Where trained models (random_forest.joblib, resnet50.pt) live
TERRASHIFT_ARTIFACT_DIR=./artifacts
# Root directory that tile before/after paths are resolved against
TERRASHIFT_IMAGERY_ROOT=./data
# auto | cpu | cuda | mps
TERRASHIFT_DEVICE=auto

# Comma-separated origins allowed to call the API (React dashboard)
CORS_ORIGINS=http://localhost:5173

# Dashboard
VITE_API_URL=http://localhost:8000
